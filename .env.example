# ─── LLM (Ollama – runs locally via Docker) ───────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b        # or llama3, mistral, phi3
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Vector Database (Qdrant – runs locally via Docker) ───────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                 # leave blank for local, set for Qdrant Cloud

# ─── Job Discovery ────────────────────────────────────────────────────────
# JSearch API on RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_rapidapi_key_here
JSEARCH_HOST=jsearch.p.rapidapi.com
USE_MOCK_JOBS=true              # set false to use JSearch API

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/career_copilot.db
# For production: postgresql://user:password@host:5432/career_copilot

# ─── App Settings ─────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-long-random-string
ENVIRONMENT=development         # development | production
LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=10
SESSION_TTL_HOURS=24

# ─── ATS Scoring Thresholds ───────────────────────────────────────────────
ATS_MIN_MATCH_SCORE=40          # Jobs below this are hidden
ATS_TARGET_SCORE_LOW=80         # Trigger optimization below this
ATS_TARGET_SCORE_HIGH=95        # Optimization ceiling

# ─── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
